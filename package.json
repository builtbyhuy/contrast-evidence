{
  "name": "@builtbyhuy/contrast-evidence",
  "version": "0.1.1",
  "description": "Reproducible contrast evidence for stationary text over images and gradients.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "contrast-evidence": "src/cli.js" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./math": "./src/contrast.js"
  },
  "types": "src/index.d.ts",
  "files": ["src", "skills", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/serve.js",
    "test:browser": "node --test tests/capture.test.js",
    "test:demo": "node tests/demo-check.js"
  },
  "dependencies": { "playwright": "1.62.1", "pngjs": "7.0.0" },
  "devDependencies": { "@axe-core/playwright": "4.11.0" },
  "repository": { "type": "git", "url": "https://github.com/builtbyhuy/contrast-evidence.git" },
  "homepage": "https://builtbyhuy.github.io/contrast-evidence/demo/",
  "keywords": ["accessibility", "contrast", "playwright", "wcag", "evidence"]
}
